# Yuchen Panel example environment file.
# Copy to /etc/yuchen-panel/yuchen-panel.env on the server and change values.

YC_PANEL_PORT=2053
YC_PANEL_HOST=0.0.0.0
YC_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/sle58083/yuchen-panel/main/version.json

# Generate fresh values in production.
YC_ADMIN_USER=admin
YC_ADMIN_PASSWORD=change-me
YC_API_TOKEN=change-me
